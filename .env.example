# Copy once to .env at the repository root. Never overwrite an existing configured .env.
# This default opens an empty local app and camera preview without cloud accounts.
APP_ENV=development
DATA_DIR=.data
MEMORY_PROVIDER=sqlite
SEED_SAMPLE_DATA=false
GUEST_PROFILE_STORE=local
STORAGE_PROVIDER=local
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_UPLOAD_BYTES=8388608

# Gemini computer vision. Enable gemini and choose a model accessible to your key.
VISION_PROVIDER=demo
GEMINI_VISION_API_KEY=
GEMINI_MODEL=
# geometry avoids large local neural models; models requires services/api[spatial].
VISION_ENRICHMENT=geometry

# Remi's assistant uses Meta Muse. All keys stay on the backend.
ASSISTANT_PROVIDER=disabled
MODEL_API_KEY=
META_MODEL=
META_VOICE_MODEL=muse-voice-transcribe-1.0

# Live camera upload and object memory use the existing team module.
# Set CAMERA_FRAME_SINK=spacetimedb and MEMORY_PROVIDER=spacetimedb together.
CAMERA_FRAME_SINK=disabled
CAMERA_SPACETIMEDB_URL=https://maincloud.spacetimedb.com
CAMERA_SPACETIMEDB_DATABASE=
# Copy a matching authorized backend token only if the deployed reducers require it.
CAMERA_SPACETIMEDB_TOKEN=

# Saved-name registry is independent of object/image storage.
# local: reset names on API restart; sqlite: persist names in DATA_DIR;
# spacetimedb: use the configured remote user table; auto: legacy automatic selection.
SPACETIMEDB_URL=https://maincloud.spacetimedb.com
SPACETIMEDB_DATABASE=
SPACETIMEDB_PROFILE_TABLE=user
SPACETIMEDB_PROFILE_ACCESS=public
SPACETIMEDB_SERVER_TOKEN=

# Optional compatibility adapters; not needed for the normal Meta-powered app.
GEMINI_CHAT_API_KEY=
GEMINI_CHAT_MODEL=
GEMINI_API_KEY=
COMMONPLACE_CONNECTOR_TOKEN=

# Camera-only initial activation preference. Remi wake listening starts automatically
# when Meta is enabled and the browser permits it; it has no on/off menu switch.
# VITE_MEDIA_AUTOSTART=false
