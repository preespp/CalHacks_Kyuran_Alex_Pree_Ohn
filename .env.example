# Copy to .env in the repository root. Defaults run without cloud accounts.
# development locally; prototype enables the name-only guest deployment mode.
# production remains unsupported until verified identity/private households are implemented.
APP_ENV=development
DATA_DIR=.data
VISION_PROVIDER=demo
# Enable the shared-memory Muse assistant with ASSISTANT_PROVIDER=muse. Defaults make no paid calls.
ASSISTANT_PROVIDER=disabled
# Separate BACKEND-ONLY credentials for the team's two integrations.
# Optional previous Gemini assistant adapter; active Muse setup uses MODEL_API_KEY below.
GEMINI_CHAT_API_KEY=
# The computer-vision teammate's key goes here; leave blank when vision is demo.
GEMINI_VISION_API_KEY=
# Image-capable model with structured output, required for VISION_PROVIDER=gemini.
GEMINI_MODEL=
# Function-calling model for ASSISTANT_PROVIDER=gemini; falls back to GEMINI_MODEL.
GEMINI_CHAT_MODEL=
# Optional legacy shared-key fallback. Leave blank to enforce separate credentials.
# Each adapter prefers its own key above and otherwise uses this shared key.
GEMINI_API_KEY=
STORAGE_PROVIDER=local
# Used only with STORAGE_PROVIDER=azure. Authenticate locally with az login.
AZURE_STORAGE_ACCOUNT_URL=
AZURE_STORAGE_CONTAINER=scene-images
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_UPLOAD_BYTES=8388608
# SpacetimeDB can store saved-user profiles when enabled below.
# Object memory and session hashes still use SQLite; these values do not migrate them.
SPACETIMEDB_URL=http://localhost:3000
SPACETIMEDB_DATABASE=commonplace-dev
# Saved-user registry only; image/object storage remains configured separately.
# auto: use SpacetimeDB with a server token or explicit public access; otherwise temporary local users.
# local: reset selectable users/sessions on API restart. sqlite: keep them in DATA_DIR.
# spacetimedb: require the configured remote registry; no missing-database fallback.
GUEST_PROFILE_STORE=auto
# private requires a backend owner token; public uses a public insert-only guest table.
# Our separate users-only module is now public: see spacetimedb/users/README.md.
# See spacetimedb/guest-table/README.md before enabling public against an existing database.
SPACETIMEDB_PROFILE_ACCESS=private
# BACKEND ONLY: database-owner token for private profile reads. Never use VITE_*.
SPACETIMEDB_SERVER_TOKEN=

# Backend-only Meta Model API credentials for Muse chat and Muse Voice Transcribe.
# Choose META_MODEL from your Meta dashboard (e.g. muse-spark-1.3).
MODEL_API_KEY=
META_MODEL=
META_VOICE_MODEL=muse-voice-transcribe-1.0
# Optional read-only Muse test gateway. Use a LOCAL API demo session token here,
# never MODEL_API_KEY. Tunnel gateway port 8001, keeping API port 8000 local.
COMMONPLACE_CONNECTOR_TOKEN=

# Camera/Muse attempt activation by default, subject to browser permissions.
# Set false only to disable initial activation during manual/browser testing.
# VITE_MEDIA_AUTOSTART=false
# For a separate users-only cloud registry, see spacetimedb/users/README.md.
# Never publish that module over the teammate object database.
